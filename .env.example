# Database
POSTGRES_DB=blip
POSTGRES_USER=blip
POSTGRES_PASSWORD=change-this-password

# Redis
REDIS_PASSWORD=change-this-redis-password

# MinIO (S3-compatible storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-minio-password

# n8n
N8N_DB=n8n
N8N_USER=admin
N8N_PASSWORD=change-this-n8n-password
N8N_ENCRYPTION_KEY=change-this-32-char-encryption-key
N8N_WEBHOOK_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=change-this-webhook-secret

# Backend
SECRET_KEY=change-this-secret-key-min-32-chars
ENVIRONMENT=development

# External APIs
# Google Maps API key is OPTIONAL — the platform works without it using free OpenStreetMap/Overpass/Nominatim
# Add it only if you want Google Places data (reviews, ratings, more accurate business listings)
GOOGLE_MAPS_API_KEY=

# Get FREE Groq key at https://console.groq.com (no credit card, 14,400 req/day)
AI_API_KEY=your-groq-api-key-here

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Razorpay (payments)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Email (optional for alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
